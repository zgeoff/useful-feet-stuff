// Button Press/Release macro built from the 1A Button Press-Release Template
//


///////////////////////////
// This gets called when button is first pressed down
PROCEDURE ButtonDown
	
	
	KeyActionHid(0x00,0x63,1)


RETURN
END

////////////////////////////////////////////////
// This gets called every 16ms while the button is held down
PROCEDURE ButtonDownRepeat

	


RETURN
END


////////////////////
// This gets called when button is released
PROCEDURE ButtonUp

	
	KeyActionHid(0x00,0x63,0)


RETURN
END


THREAD Profile
	Start:
		WaitForButton(Button, ButtonMask)
		
		ButtonDown()
		
		DO
			ButtonDownRepeat()
			DelayForMs(16)	
		WHILE ((GetButtonState & ButtonMask) == Button)
		
		ButtonUp()
		
		GOTO Start
END


